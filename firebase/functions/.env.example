# Non-secret Stripe params. Secret keys stay in Google Secret Manager:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# Never copy sk_live / whsec values into client JavaScript.

STRIPE_PLUS_PRICE_ID=price_1UADb6G7IvO9PkSLxBMSEOsS
STRIPE_PLUS_ANNUAL_PRICE_ID=price_1UADb6G7IvO9PkSLQJ94b6JA
STRIPE_CHECKOUT_ORIGINS=https://famielda.web.app,https://famielda.firebaseapp.com
STRIPE_SECRET_KEY=sk_test_or_live_from_secret_manager
STRIPE_WEBHOOK_SECRET=whsec_from_secret_manager

# Contact-form SMTP. Secret values stay in Google Secret Manager:
#   firebase functions:secrets:set MAIL_SMTP_USER
#   firebase functions:secrets:set MAIL_SMTP_PASS
# Never copy SMTP passwords into client JavaScript.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=465
MAIL_FROM=Famielda <support@famielda.org>
